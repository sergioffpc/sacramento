+        COMMAND ${CMAKE_SOURCE_DIR}/build_scripts/wrap_setpath.sh ${TOOLS_PYTHON} ${CMAKE_SOURCE_DIR}/build_scripts/generate_stubs.py ${FALCOR_OUTPUT_DIRECTORY}/python || (exit 0)
