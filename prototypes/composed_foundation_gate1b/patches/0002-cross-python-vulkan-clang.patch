diff --git a/CMakeLists.txt b/CMakeLists.txt
index 95e293d..a44671a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -6,0 +7,3 @@ cmake_policy(SET CMP0057 NEW)
+if(POLICY CMP0190)
+    cmake_policy(SET CMP0190 NEW)
+endif()
@@ -59,3 +62,9 @@ message(STATUS "Platform: ${FALCOR_PLATFORM}")
-# Check if D3D12/Vulkan are available.
-set(FALCOR_HAS_D3D12 ${FALCOR_WINDOWS})
-set(FALCOR_HAS_VULKAN ON)
+# Select available rendering backends.
+set(FALCOR_HAS_D3D12 ${FALCOR_WINDOWS} CACHE BOOL "Enable D3D12 backend")
+set(FALCOR_HAS_VULKAN ON CACHE BOOL "Enable Vulkan backend")
+if(FALCOR_HAS_D3D12 AND NOT FALCOR_WINDOWS)
+    message(FATAL_ERROR "The D3D12 backend requires a Windows target.")
+endif()
+if(NOT FALCOR_HAS_D3D12 AND NOT FALCOR_HAS_VULKAN)
+    message(FATAL_ERROR "At least one rendering backend must be enabled.")
+endif()
@@ -148 +161,12 @@ endif()
-if(FALCOR_USE_SYSTEM_PYTHON)
+if(CMAKE_CROSSCOMPILING)
+    if(FALCOR_USE_SYSTEM_PYTHON)
+        message(FATAL_ERROR "System target Python is not supported when cross-compiling Falcor.")
+    endif()
+    set(Python_ROOT_DIR ${CMAKE_SOURCE_DIR}/external/packman/python)
+    find_package(Python 3.10 EXACT COMPONENTS Development REQUIRED)
+    set(Python_ARTIFACTS_PREFIX "_HOST")
+    find_package(Python COMPONENTS Interpreter REQUIRED)
+    set(TOOLS_PYTHON ${Python_HOST_EXECUTABLE})
+    set(Python_EXECUTABLE ${Python_HOST_EXECUTABLE})
+    unset(Python_ARTIFACTS_PREFIX)
+elseif(FALCOR_USE_SYSTEM_PYTHON)
@@ -155 +179,3 @@ endif()
-if(FALCOR_WINDOWS)
+if(CMAKE_CROSSCOMPILING)
+    # TOOLS_PYTHON was selected from the build host above.
+elseif(FALCOR_WINDOWS)
@@ -350 +376,5 @@ file(TO_NATIVE_PATH ${output_dir} output_dir)
-if(FALCOR_WINDOWS)
+if(CMAKE_CROSSCOMPILING)
+    # Sacramento assembles the target SDK after compilation. Host scripts must
+    # not attempt to execute target-platform deployment scripts.
+    add_custom_target(deploy_dependencies ALL)
+elseif(FALCOR_WINDOWS)
